# Babylon Chain Configuration - REAL ENDPOINTS!
# Using Polkachu for testnet (bbn-test-6)
BABYLON_RPC_URL=https://babylon-testnet-rpc.polkachu.com
BABYLON_REST_URL=https://babylon-testnet-api.polkachu.com
BABYLON_WS_URL=wss://babylon-testnet-rpc.polkachu.com/websocket
START_HEIGHT=1
CHAIN_ID=bbn-test-6

# Database Configuration
DATABASE_URL=postgresql://dev:dev_password@localhost:5432/babylon_analytics
DATABASE_POOL_SIZE=20
DATABASE_ECHO=false

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_DB=0

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_RELOAD=true

# Logging Configuration
LOG_LEVEL=DEBUG
LOG_TO_FILE=false
LOG_FILE=babylon_analytics.log

# Indexer Configuration
INDEXER_BATCH_SIZE=100
INDEXER_CHECKPOINT_INTERVAL=100
INDEXER_RETRY_ATTEMPTS=3
INDEXER_RETRY_DELAY=5
INDEXER_BLOCK_TIME=6.0

# Performance Configuration
MAX_WORKERS=4
REQUEST_TIMEOUT=30

# Security Configuration
API_KEY_ENABLED=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
